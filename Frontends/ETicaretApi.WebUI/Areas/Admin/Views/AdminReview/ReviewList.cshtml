@using ETicaretApi.Dto.Dtos.AdminReviewDtos
@model List<AdminResultReviewDto>
@{
    ViewData["Title"] = "ReviewList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
}

<div class="p-lg">
    <!-- Başlık ve Üst Bar -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-lg">
        <div>
            <h1 class="font-headline-md text-headline-md text-on-surface font-bold">@ViewBag.v1</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-xs">@ViewBag.v2 / <span class="text-primary font-semibold">@ViewBag.v3</span></p>
        </div>

        <!-- Toplam Yorum Rozeti -->
        <div class="px-md py-sm bg-surface-container-high text-primary rounded-xl font-bold border border-primary/20 flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">rate_review</span>
            Toplam @totalItems Yorum
        </div>
    </div>

    <!-- Yorumlar Tablosu (Stitch Dark Theme) -->
    <div class="bg-surface-container-low rounded-2xl shadow-md border border-outline-variant/10 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-outline-variant/10 bg-surface-container-lowest/50 text-on-surface-variant font-label-caps text-label-caps uppercase">
                        <th class="p-md">#</th>
                        <th class="p-md">İlgili Ürün</th>
                        <th class="p-md">Puan</th>
                        <th class="p-md">Yorum İçeriği</th>
                        <th class="p-md">Tarih</th>
                        <th class="p-md text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 font-body-md text-body-md">
                    @if (Model != null && Model.Count > 0)
                    {
                        int count = (currentPage - 1) * pageSize;
                        foreach (var item in Model)
                        {
                            count++;
                            <tr class="hover:bg-surface-container-high/40 transition-colors">
                                <td class="p-md text-on-surface-variant font-bold">@count</td>
                                <td class="p-md">
                                    <span class="font-bold text-primary text-body-md">
                                        @(string.IsNullOrEmpty(item.ProductName) ? "Belirtilmemiş" : item.ProductName)
                                    </span>
                                </td>
                                <td class="p-md">
                                    <div class="flex items-center gap-1 text-amber-400">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Rating)
                                            {
                                                <span class="material-symbols-outlined text-[18px]">star</span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined text-[18px] text-outline-variant/40">star</span>
                                            }
                                        }
                                        <span class="text-xs text-on-surface-variant ml-1 font-bold">(@item.Rating/5)</span>
                                    </div>
                                </td>
                                <td class="p-md text-on-surface max-w-md">
                                    <div class="font-medium text-body-md">@item.Comment</div>
                                </td>
                                <td class="p-md text-on-surface-variant text-sm">
                                    @item.ReviewDate.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="p-md text-center">
                                    <a href="/Admin/AdminReview/DeleteReview?id=@item.ReviewID" onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?');" class="px-3 py-1.5 bg-error-container text-on-error-container rounded-lg font-semibold hover:bg-error hover:text-on-error transition-colors inline-flex items-center gap-1 text-sm">
                                        <span class="material-symbols-outlined text-[16px]">delete</span>
                                        Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-lg text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-[32px] mb-2 text-outline">rate_review</span>
                                <div>Henüz kayıtlı müşteri yorumu bulunmuyor.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Sayfalama (Pagination Bar) -->
        <div class="p-md border-t border-outline-variant/10 bg-surface-container-lowest/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-on-surface-variant">
            <div>
                Toplam <span class="font-bold text-on-surface">@totalItems</span> yorumdan 
                @if (totalItems > 0)
                {
                    <span class="font-bold text-on-surface">@(((currentPage - 1) * pageSize) + 1) - @(Math.Min(currentPage * pageSize, totalItems))</span> <span>arası gösteriliyor</span>
                }
            </div>
            
            @if (totalPages > 1)
            {
                <div class="flex items-center gap-1">
                    <a href="/Admin/AdminReview/ReviewList?page=@(currentPage - 1)&pageSize=@pageSize" class="px-3 py-1.5 rounded-lg border border-outline-variant/20 @(currentPage <= 1 ? "opacity-30 pointer-events-none" : "hover:bg-surface-container-high text-on-surface") transition-colors flex items-center">
                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                    </a>

                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <a href="/Admin/AdminReview/ReviewList?page=@p&pageSize=@pageSize" class="px-3 py-1.5 rounded-lg font-bold text-xs @(p == currentPage ? "bg-primary text-on-primary shadow-sm" : "hover:bg-surface-container-high text-on-surface border border-outline-variant/20") transition-colors">
                            @p
                        </a>
                    }

                    <a href="/Admin/AdminReview/ReviewList?page=@(currentPage + 1)&pageSize=@pageSize" class="px-3 py-1.5 rounded-lg border border-outline-variant/20 @(currentPage >= totalPages ? "opacity-30 pointer-events-none" : "hover:bg-surface-container-high text-on-surface") transition-colors flex items-center">
                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
