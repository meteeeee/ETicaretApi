@using ETicaretApi.Dto.Dtos.AdminUserDtos
@model List<AdminResultUserDto>
@{
    ViewData["Title"] = "UserList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;
}

<div class="p-lg">
    <!-- Başlık ve Yeni Ekle Butonu -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-lg">
        <div>
            <h1 class="font-headline-md text-headline-md text-on-surface font-bold">@ViewBag.v1</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-xs">@ViewBag.v2 / <span class="text-primary font-semibold">@ViewBag.v3</span></p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Admin/AdminUser/CreateAdmin" class="px-md py-sm bg-primary text-on-primary rounded-xl font-bold hover:bg-primary/90 transition-all flex items-center gap-2 shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                Yeni Yönetici (Admin) Ekle
            </a>
        </div>
    </div>

    <!-- Kullanıcılar Tablosu (Stitch Dark Theme) -->
    <div class="bg-surface-container-low rounded-2xl shadow-md border border-outline-variant/10 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-outline-variant/10 bg-surface-container-lowest/50 text-on-surface-variant font-label-caps text-label-caps uppercase">
                        <th class="p-md">#</th>
                        <th class="p-md">Ad Soyad</th>
                        <th class="p-md">Kullanıcı Adı</th>
                        <th class="p-md">E-Posta</th>
                        <th class="p-md">Rol</th>
                        <th class="p-md text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 font-body-md text-body-md">
                    @if (Model != null && Model.Count > 0)
                    {
                        int count = (currentPage - 1) * pageSize;
                        foreach (var item in Model)
                        {
                            count++;
                            <tr class="hover:bg-surface-container-high/40 transition-colors">
                                <td class="p-md text-on-surface-variant font-bold">@count</td>
                                <td class="p-md font-bold text-on-surface">
                                    @(string.IsNullOrWhiteSpace(item.FirstName) ? "Belirtilmemiş" : $"{item.FirstName} {item.LastName}")
                                </td>
                                <td class="p-md text-primary font-semibold">
                                    @@@item.UserName
                                </td>
                                <td class="p-md text-on-surface-variant">
                                    @item.Email
                                </td>
                                <td class="p-md">
                                    @if (item.Role == "Admin")
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-amber-500/20 text-amber-400 border border-amber-500/30 inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">shield_person</span>
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">person</span>
                                            Kullanıcı
                                        </span>
                                    }
                                </td>
                                <td class="p-md text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="/Admin/AdminUser/UpdateUser?id=@item.Id" class="px-3 py-1.5 bg-primary/20 text-primary hover:bg-primary hover:text-on-primary rounded-lg font-semibold transition-colors inline-flex items-center gap-1 text-sm">
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                            Düzenle / Şifre Değiş
                                        </a>
                                        <a href="/Admin/AdminUser/DeleteUser?id=@item.Id" onclick="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');" class="px-3 py-1.5 bg-error-container text-on-error-container hover:bg-error hover:text-on-error rounded-lg font-semibold transition-colors inline-flex items-center gap-1 text-sm">
                                            <span class="material-symbols-outlined text-[16px]">delete</span>
                                            Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-lg text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-[32px] mb-2 text-outline">group</span>
                                <div>Kayıtlı kullanıcı bulunamadı.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Sayfalama (Pagination Bar) -->
        <div class="p-md border-t border-outline-variant/10 bg-surface-container-lowest/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-on-surface-variant">
            <div>
                Toplam <span class="font-bold text-on-surface">@totalItems</span> kullanıcıdan 
                @if (totalItems > 0)
                {
                    <span class="font-bold text-on-surface">@(((currentPage - 1) * pageSize) + 1) - @(Math.Min(currentPage * pageSize, totalItems))</span> <span>arası gösteriliyor</span>
                }
            </div>
            
            @if (totalPages > 1)
            {
                <div class="flex items-center gap-1">
                    <a href="/Admin/AdminUser/UserList?page=@(currentPage - 1)&pageSize=@pageSize" class="px-3 py-1.5 rounded-lg border border-outline-variant/20 @(currentPage <= 1 ? "opacity-30 pointer-events-none" : "hover:bg-surface-container-high text-on-surface") transition-colors flex items-center">
                        <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                    </a>

                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <a href="/Admin/AdminUser/UserList?page=@p&pageSize=@pageSize" class="px-3 py-1.5 rounded-lg font-bold text-xs @(p == currentPage ? "bg-primary text-on-primary shadow-sm" : "hover:bg-surface-container-high text-on-surface border border-outline-variant/20") transition-colors">
                            @p
                        </a>
                    }

                    <a href="/Admin/AdminUser/UserList?page=@(currentPage + 1)&pageSize=@pageSize" class="px-3 py-1.5 rounded-lg border border-outline-variant/20 @(currentPage >= totalPages ? "opacity-30 pointer-events-none" : "hover:bg-surface-container-high text-on-surface") transition-colors flex items-center">
                        <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
