@using ETicaretApi.Dto.Dtos.AdminUserDtos
@model AdminUpdateUserDto
@{
    ViewData["Title"] = "UpdateUser";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-lg max-w-3xl">
    <div class="mb-lg">
        <h1 class="font-headline-md text-headline-md text-on-surface font-bold">@ViewBag.v1</h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-xs">@ViewBag.v2 / <span class="text-primary font-semibold">@ViewBag.v3</span></p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="p-md mb-md bg-error-container text-on-error-container rounded-xl font-medium border border-error/30">
            @ViewBag.Error
        </div>
    }

    <div class="bg-surface-container-low p-xl rounded-2xl border border-outline-variant/10 shadow-md">
        <form method="post" action="/Admin/AdminUser/UpdateUser" class="space-y-md">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Ad</label>
                    <input type="text" name="FirstName" value="@Model.FirstName" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Soyad</label>
                    <input type="text" name="LastName" value="@Model.LastName" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" required />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Kullanıcı Adı</label>
                    <input type="text" name="UserName" value="@Model.UserName" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">E-Posta</label>
                    <input type="email" name="Email" value="@Model.Email" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" required />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Kullanıcı Rolü</label>
                <select name="Role" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary">
                    @if (Model.Role == "Admin")
                    {
                        <option value="Admin" selected>👑 Admin (Yönetici Yetkisi)</option>
                        <option value="User">👤 User (Standart Müşteri)</option>
                    }
                    else
                    {
                        <option value="Admin">👑 Admin (Yönetici Yetkisi)</option>
                        <option value="User" selected>👤 User (Standart Müşteri)</option>
                    }
                </select>
            </div>

            <div class="p-md rounded-xl bg-surface-container-lowest/50 border border-outline-variant/10">
                <label class="block text-xs font-bold text-amber-400 uppercase tracking-wider mb-2 flex items-center gap-1">
                    <span class="material-symbols-outlined text-[18px]">lock_reset</span>
                    Yeni Şifre Belirle (İsteğe Bağlı)
                </label>
                <input type="password" name="NewPassword" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                <p class="text-xs text-on-surface-variant mt-1">Şifreyi güncellemek istiyorsanız yeni şifreyi yazınız.</p>
            </div>

            <div class="flex items-center gap-3 pt-md border-t border-outline-variant/10">
                <button type="submit" class="px-lg py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary/90 transition-all flex items-center gap-2 shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-[20px]">save</span>
                    Değişiklikleri Kaydet
                </button>
                <a href="/Admin/AdminUser/UserList" class="px-lg py-3 bg-surface-container-high text-on-surface-variant rounded-xl font-semibold hover:bg-surface-container-highest transition-colors">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>
