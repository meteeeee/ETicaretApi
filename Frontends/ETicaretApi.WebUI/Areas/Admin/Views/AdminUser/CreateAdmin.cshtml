@using ETicaretApi.Dto.Dtos.AdminUserDtos
@model AdminCreateAdminDto
@{
    ViewData["Title"] = "CreateAdmin";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-lg max-w-3xl">
    <div class="mb-lg">
        <h1 class="font-headline-md text-headline-md text-on-surface font-bold">@ViewBag.v1</h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-xs">@ViewBag.v2 / <span class="text-primary font-semibold">@ViewBag.v3</span></p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="p-md mb-md bg-error-container text-on-error-container rounded-xl font-medium border border-error/30">
            @ViewBag.Error
        </div>
    }

    <div class="bg-surface-container-low p-xl rounded-2xl border border-outline-variant/10 shadow-md">
        <form method="post" action="/Admin/AdminUser/CreateAdmin" class="space-y-md">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Ad</label>
                    <input type="text" name="FirstName" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" placeholder="Ad giriniz" required />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Soyad</label>
                    <input type="text" name="LastName" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" placeholder="Soyad giriniz" required />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Kullanıcı Adı</label>
                <input type="text" name="UserName" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" placeholder="Örn: mete_admin" required />
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">E-Posta Adresi</label>
                <input type="email" name="Email" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" placeholder="admin@eticaret.com" required />
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Admin Giriş Şifresi</label>
                <input type="password" name="Password" class="w-full px-4 py-3 bg-surface-container-high border border-outline-variant/20 rounded-xl text-on-surface focus:outline-none focus:border-primary" placeholder="En az 8 karakter, büyük harf, rakam ve özel karakter (*)" required />
            </div>

            <div class="flex items-center gap-3 pt-md border-t border-outline-variant/10">
                <button type="submit" class="px-lg py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary/90 transition-all flex items-center gap-2 shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-[20px]">shield_person</span>
                    Admin Olarak Kaydet
                </button>
                <a href="/Admin/AdminUser/UserList" class="px-lg py-3 bg-surface-container-high text-on-surface-variant rounded-xl font-semibold hover:bg-surface-container-highest transition-colors">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>
