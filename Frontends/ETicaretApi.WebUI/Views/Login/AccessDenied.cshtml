@{
    ViewData["Title"] = "Erişim Reddedildi";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 text-center">
            <div class="card border-0 shadow-lg rounded-2xl p-5 bg-white">
                <div class="w-20 h-20 mx-auto mb-4 bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="fas fa-shield-alt fa-3x text-danger"></i>
                </div>
                
                <h2 class="font-weight-bold text-dark mb-2">Yetkisiz Erişim (403)</h2>
                <p class="text-muted mb-4 lead">
                    Yönetim Paneline erişim izniniz bulunmuyor. Bu sayfa yalnızca <strong class="text-danger">Admin (Yönetici)</strong> yetkisine sahip hesaplar içindir.
                </p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    <a href="/Product/ProductList" class="btn btn-outline-secondary px-4 py-2 rounded-pill font-weight-bold mr-2 mb-2">
                        <i class="fas fa-arrow-left mr-2"></i>Alışverişe Dön
                    </a>
                    <a href="/Login/SignIn" class="btn btn-danger px-4 py-2 rounded-pill font-weight-bold shadow-sm mb-2">
                        <i class="fas fa-user-shield mr-2"></i>Admin Girişi Yap
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
