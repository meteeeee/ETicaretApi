@using ETicaretApi.Dto.Dtos.UserLoginDtos
@model UserLoginDto
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="card border-0 shadow-lg rounded-lg overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="font-weight-bold text-white mb-0"><i class="fas fa-lock mr-2"></i>Giriş Yap</h3>
                    <p class="text-white-50 small mb-0 mt-1">E-Ticaret hesabınıza veya Yönetim Paneline erişin</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle mr-2"></i>@ViewBag.Error
                        </div>
                    }

                    <form method="post" action="/Login/SignIn">
                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark"><i class="fas fa-user text-primary mr-2"></i>Kullanıcı Adı</label>
                            <input type="text" name="UserName" class="form-control form-control-lg rounded-pill px-4" placeholder="Kullanıcı adınızı giriniz" required />
                        </div>
                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark"><i class="fas fa-key text-primary mr-2"></i>Şifre</label>
                            <input type="password" name="Password" class="form-control form-control-lg rounded-pill px-4" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-block btn-lg rounded-pill font-weight-bold shadow-sm mt-4">
                            <i class="fas fa-sign-in-alt mr-2"></i>Giriş Yap
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
