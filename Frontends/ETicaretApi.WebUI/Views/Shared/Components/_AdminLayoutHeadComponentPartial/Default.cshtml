<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>Admin Dashboard - ETicaret</title>
<style>
    @@layer base {
        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            overscroll-behavior: none;
        }

        main > :first-child {
            margin-top: 0 !important;
        }

        main > :last-child {
            margin-bottom: 0 !important;
        }
    }

    ::-webkit-scrollbar {
        display: none;
    }
</style>
