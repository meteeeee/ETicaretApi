<!-- Navbar Start -->
<div class="container-fluid">
    <div class="row border-top px-xl-5">
        @await Component.InvokeAsync("_UserLayoutWebUICategoriesComponentPartial")
        <div class="col-lg-9">
            <nav class="navbar navbar-expand-lg bg-light navbar-light py-3 py-lg-0 px-0">
                <a href="/" class="text-decoration-none d-block d-lg-none">
                    <h1 class="m-0 display-5 font-weight-semi-bold"><span class="text-primary font-weight-bold border px-3 mr-1">E</span>Ticaret</h1>
                </a>
                <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                    <div class="navbar-nav mr-auto py-0">
                        <a href="/" class="nav-item nav-link">Ana Sayfa</a>
                        <a href="/Product/ProductList" class="nav-item nav-link">Ürünler</a>
                        <a href="/Cart/Index" class="nav-item nav-link font-weight-bold text-primary">
                            <i class="fas fa-shopping-cart mr-1"></i>Sepetim
                        </a>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a href="/Order/MyOrders" class="nav-item nav-link font-weight-bold text-dark">
                                <i class="fas fa-box text-primary mr-1"></i>Siparişlerim
                            </a>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <a href="/Admin/AdminProduct/ProductList" class="nav-item nav-link font-weight-bold text-dark">
                                <i class="fas fa-crown text-warning mr-1"></i>Admin Paneli
                            </a>
                        }
                    </div>
                    <div class="navbar-nav ml-auto py-0 align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="nav-item nav-link text-dark font-weight-semi-bold">
                                <i class="fas fa-user-circle text-primary mr-1"></i>@User.Identity.Name
                            </span>
                            <a href="/Login/Logout" class="nav-item nav-link text-danger font-weight-bold">
                                <i class="fas fa-sign-out-alt mr-1"></i>Çıkış Yap
                            </a>
                        }
                        else
                        {
                            <a href="javascript:void(0)" class="nav-item nav-link" data-toggle="modal" data-target="#loginModal"><i class="fas fa-sign-in-alt mr-1 text-primary"></i>Giriş Yap</a>
                            <a href="javascript:void(0)" class="nav-item nav-link" data-toggle="modal" data-target="#registerModal"><i class="fas fa-user-plus mr-1 text-primary"></i>Kayıt Ol</a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </div>
</div>
<!-- Navbar End -->
