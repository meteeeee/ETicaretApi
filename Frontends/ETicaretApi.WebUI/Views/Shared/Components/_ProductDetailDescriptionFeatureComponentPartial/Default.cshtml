@using ETicaretApi.Dto.Dtos.ProductDtos
@model ResultProductDto

<!-- Product Detail Description Feature Start -->
<div class="col-lg-7 pb-5">
    @if (TempData["CartSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-lg shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle mr-2 text-success"></i>
            <strong>Harika!</strong> @TempData["CartSuccess"]
            <a href="/Cart/Index" class="btn btn-sm btn-success font-weight-bold ml-3 px-3 rounded-pill shadow-sm">
                <i class="fas fa-shopping-cart mr-1"></i>Sepete Git
            </a>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <h3 class="font-weight-semi-bold text-dark">@(Model != null ? Model.ProductName : "Ürün Başlığı")</h3>
    <div class="d-flex mb-3">
        <div class="text-warning mr-2">
            <small class="fas fa-star"></small>
            <small class="fas fa-star"></small>
            <small class="fas fa-star"></small>
            <small class="fas fa-star"></small>
            <small class="fas fa-star-half-alt"></small>
        </div>
        <small class="pt-1 text-muted">(Müşteri Değerlendirmeleri)</small>
    </div>
    <h3 class="font-weight-semi-bold mb-4 text-primary">
        ₺@(Model != null ? Model.ProductPrice.ToString("N2") : "0")
    </h3>
    <p class="mb-4 text-dark">
        Yüksek kalite standartlarında üretilmiş orijinal e-ticaret ürünü. Hızlı teslimat, orijinal ürün garantisi ve güvenli kargo avantajıyla sizlerle.
    </p>

    <!-- Quantity and Add to Cart Form -->
    <form method="post" action="/Cart/AddToCart" class="d-flex align-items-center mb-4 pt-2">
        <input type="hidden" name="productId" value="@Model?.ProductID" />
        <div class="input-group quantity mr-3" style="width: 130px;">
            <div class="input-group-btn">
                <button class="btn btn-primary btn-minus" type="button">
                    <i class="fa fa-minus"></i>
                </button>
            </div>
            <input type="text" id="qty" name="quantity" class="form-control bg-secondary text-center font-weight-bold" value="1">
            <div class="input-group-btn">
                <button class="btn btn-primary btn-plus" type="button">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
        </div>
        <button type="submit" class="btn btn-primary px-4 py-2 font-weight-semi-bold shadow-sm">
            <i class="fa fa-shopping-cart mr-2"></i> Sepete Ekle
        </button>
    </form>

    <!-- Social Share -->
    <div class="d-flex pt-2">
        <p class="text-dark font-weight-medium mb-0 mr-2">Paylaş:</p>
        <div class="d-inline-flex">
            <a class="text-dark px-2" href="#"><i class="fab fa-facebook-f"></i></a>
            <a class="text-dark px-2" href="#"><i class="fab fa-twitter"></i></a>
            <a class="text-dark px-2" href="#"><i class="fab fa-whatsapp"></i></a>
            <a class="text-dark px-2" href="#"><i class="fab fa-pinterest"></i></a>
        </div>
    </div>
</div>
<!-- Product Detail Description Feature End -->
