@using ETicaretApi.Dto.Dtos.ProductDtos
@model ResultProductDto

<!-- Product Detail Image Gallery Start -->
<div class="col-lg-5 pb-5">
    <div class="border rounded overflow-hidden bg-white p-3 text-center shadow-sm">
        @if (Model != null && !string.IsNullOrEmpty(Model.ProductImageURL))
        {
            <img class="img-fluid w-100 rounded" src="@Model.ProductImageURL" alt="@Model.ProductName" style="max-height: 480px; object-fit: contain;">
        }
        else
        {
            <img class="img-fluid w-100 rounded" src="~/eshopper/img/product-1.jpg" alt="Ürün Resmi" style="max-height: 480px; object-fit: contain;">
        }
    </div>
</div>
<!-- Product Detail Image Gallery End -->
