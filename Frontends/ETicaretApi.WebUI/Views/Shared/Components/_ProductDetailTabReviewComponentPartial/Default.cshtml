@using ETicaretApi.Dto.Dtos.AdminReviewDtos
@model List<AdminResultReviewDto>
@{
    var productId = ViewBag.ProductId;
    var reviewCount = Model?.Count ?? 0;
}

<!-- Product Detail Tabs Start -->
<div class="col-12 mt-4">
    <div class="nav nav-tabs justify-content-center border-secondary mb-4">
        <a class="nav-item nav-link active font-weight-semi-bold" data-toggle="tab" href="#tab-pane-1"><i class="fas fa-file-alt mr-1"></i> Ürün Açıklaması</a>
        <a class="nav-item nav-link font-weight-semi-bold" data-toggle="tab" href="#tab-pane-2"><i class="fas fa-truck mr-1"></i> Teslimat & İade</a>
        <a class="nav-item nav-link font-weight-semi-bold" data-toggle="tab" href="#tab-pane-3"><i class="fas fa-comments mr-1"></i> Müşteri Yorumları (@reviewCount)</a>
    </div>
    <div class="tab-content">
        <!-- Tab 1: Açıklama -->
        <div class="tab-pane fade show active" id="tab-pane-1">
            <h4 class="mb-3 font-weight-semi-bold">Ürün Açıklaması</h4>
            <p class="text-dark">Bu ürün %100 orijinal ve faturalı olarak tarafınıza gönderilmektedir. Resmi distribütör garantisi altındadır.</p>
            <p class="text-dark">Hızlı teslimat, güvenli paketleme ve 14 gün koşulsuz iade avantajıyla güvenle satın alabilirsiniz.</p>
        </div>

        <!-- Tab 2: Teslimat -->
        <div class="tab-pane fade" id="tab-pane-2">
            <h4 class="mb-3 font-weight-semi-bold">Kargo, Teslimat ve İade Koşulları</h4>
            <p class="text-dark">Siparişleriniz 24 saat içerisinde anlaşmalı hızlı kargo firmamıza teslim edilir. Tüm siparişlerde kargo takip numarası SMS olarak iletilir.</p>
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 text-dark"><i class="fa fa-check text-primary mr-2"></i> 14 Gün Koşulsuz İade ve Değişim Garantisi</li>
                        <li class="list-group-item px-0 text-dark"><i class="fa fa-check text-primary mr-2"></i> Orijinal ve Faturalı Ürün Güvencesi</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 text-dark"><i class="fa fa-check text-primary mr-2"></i> Sigortalı ve Hasarsız Teslimat</li>
                        <li class="list-group-item px-0 text-dark"><i class="fa fa-check text-primary mr-2"></i> Kolay Takip Edilebilir SMS Bildirimi</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tab 3: Yorumlar -->
        <div class="tab-pane fade" id="tab-pane-3">
            <div class="row">
                <!-- Yorum Listesi -->
                <div class="col-md-6">
                    <h4 class="mb-4 font-weight-semi-bold">Müşteri Değerlendirmeleri (@reviewCount)</h4>
                    <div id="reviewsList">
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                var userDisplayName = string.IsNullOrWhiteSpace(item.UserName) ? "kullanici" : item.UserName;
                                var userInitial = userDisplayName.Substring(0, 1).ToUpper();

                                <div class="media mb-4 pb-3 border-bottom">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-3 font-weight-bold shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                                        @userInitial
                                    </div>
                                    <div class="media-body">
                                        <h6 class="font-weight-bold mb-1">
                                            <span class="text-primary font-weight-bold">@@@userDisplayName</span>
                                            <small class="text-muted ml-2">/ <i>@item.ReviewDate.ToString("dd.MM.yyyy HH:mm")</i></small>
                                        </h6>
                                        <div class="text-warning mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= item.Rating)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                        <p class="text-dark mb-0 font-weight-medium">@item.Comment</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted border rounded bg-light">
                                <i class="far fa-comment-dots fa-3x mb-2 text-primary"></i>
                                <p class="mb-0 font-weight-bold">Henüz bu ürün için değerlendirme yapılmamış.</p>
                                <small class="text-muted">İlk yorumu yapan siz olun!</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Yorum Yap / Giriş Uyarısı Bölümü -->
                <div class="col-md-6">
                    <h4 class="mb-4 font-weight-semi-bold">Yorum Yap</h4>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Giriş Yapmış Kullanıcı Formu (Server-Side Post) -->
                        <form method="post" action="/Product/AddReview">
                            <input type="hidden" name="productId" value="@productId" />
                            <input type="hidden" name="rating" id="selectedRatingInput" value="5" />

                            <div class="mb-3 p-3 bg-light rounded border">
                                <span class="text-muted small">Yorum Yapan:</span>
                                <div class="font-weight-bold text-dark"><i class="fas fa-user-circle text-primary mr-1"></i> @User.Identity.Name</div>
                            </div>
                            <div class="d-flex my-3">
                                <p class="mb-0 mr-2 text-dark font-weight-medium">Puanınız:</p>
                                <div class="text-warning" style="cursor: pointer;" id="starRating">
                                    <i class="fas fa-star" onclick="setRating(1)"></i>
                                    <i class="fas fa-star" onclick="setRating(2)"></i>
                                    <i class="fas fa-star" onclick="setRating(3)"></i>
                                    <i class="fas fa-star" onclick="setRating(4)"></i>
                                    <i class="fas fa-star" onclick="setRating(5)"></i>
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                <label class="font-weight-semi-bold">Yorumunuz</label>
                                <textarea name="comment" cols="30" rows="3" class="form-control" placeholder="Ürünle ilgili düşüncelerinizi yazın..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary px-4 py-2 font-weight-semi-bold shadow-sm">
                                <i class="fas fa-paper-plane mr-1"></i> Yorumu Gönder
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Giriş Yapmamış Kullanıcı Uyarısı -->
                        <div class="border rounded p-4 text-center bg-light shadow-sm">
                            <i class="fas fa-lock fa-3x text-primary mb-3"></i>
                            <h5 class="font-weight-bold text-dark mb-2">Yorum Yapmak İçin Giriş Yapın</h5>
                            <p class="text-muted mb-4 small">Bu ürüne değerlendirme ve yorum yapabilmek için lütfen hesabınıza giriş yapınız.</p>
                            <a href="/Login/SignIn" class="btn btn-primary px-4 py-2 font-weight-semi-bold shadow-sm">
                                <i class="fas fa-sign-in-alt mr-1"></i> Giriş Yap
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function setRating(val) {
        document.getElementById('selectedRatingInput').value = val;
        var stars = document.getElementById('starRating').getElementsByTagName('i');
        for (var i = 0; i < stars.length; i++) {
            if (i < val) {
                stars[i].className = 'fas fa-star text-warning';
            } else {
                stars[i].className = 'far fa-star text-muted';
            }
        }
    }
</script>
<!-- Product Detail Tabs End -->
