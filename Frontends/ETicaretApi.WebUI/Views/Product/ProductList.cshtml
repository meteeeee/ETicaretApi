@model List<ResultProductDto>
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<!-- Page Header Start -->
<div class="container-fluid bg-secondary mb-5">
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 200px">
        <h1 class="font-weight-semi-bold text-uppercase mb-3">@ViewBag.v1</h1>
        <div class="d-inline-flex">
            <p class="m-0"><a href="/" class="text-primary font-weight-semi-bold">@ViewBag.v2</a></p>
            <p class="m-0 px-2 text-muted">/</p>
            <p class="m-0 font-weight-semi-bold text-dark">@ViewBag.v3</p>
        </div>
    </div>
</div>
<!-- Page Header End -->

<!-- Shop / Product List Start -->
<div class="container-fluid pt-2 pb-5">
    <div class="row px-xl-5">
        <!-- Shop Product List Start (Full Width) -->
        <div class="col-12">
            <!-- Sepete Ekleme Bildirimi -->
            @if (TempData["CartSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-lg shadow-sm mb-4" role="alert">
                    <i class="fas fa-check-circle mr-2 text-success"></i>
                    <strong>Harika!</strong> @TempData["CartSuccess"]
                    <a href="/Cart/Index" class="btn btn-sm btn-success font-weight-bold ml-3 px-3 rounded-pill shadow-sm">
                        <i class="fas fa-shopping-cart mr-1"></i>Sepete Git
                    </a>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <div class="row pb-3">
                <!-- Dynamic Products from Backend API -->
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 pb-1">
                            <div class="card product-item border-0 mb-4 shadow-sm h-100">
                                <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
                                    <img class="img-fluid w-100" src="@item.ProductImageURL" alt="@item.ProductName" style="height: 260px; object-fit: cover;">
                                </div>
                                <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
                                    <h6 class="text-truncate mb-3 font-weight-semi-bold px-2" title="@item.ProductName">@item.ProductName</h6>
                                    <div class="d-flex justify-content-center">
                                        <h6 class="text-primary font-weight-bold">₺@item.ProductPrice.ToString("N2")</h6>
                                    </div>
                                </div>
                                <div class="card-footer d-flex justify-content-between bg-light border">
                                    <a href="/Product/ProductDetail/@item.ProductID" class="btn btn-sm text-dark p-0 font-weight-medium">
                                        <i class="fas fa-eye text-primary mr-1"></i>Detay
                                    </a>
                                    <form method="post" action="/Cart/AddToCart" class="m-0 p-0 d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductID" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm text-dark p-0 border-0 bg-transparent font-weight-medium" title="Sepete Ekle">
                                            <i class="fas fa-shopping-cart text-primary mr-1"></i>Sepete Ekle
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <div class="alert alert-info py-4">
                            <i class="fas fa-info-circle fa-2x mb-3 text-primary"></i>
                            <h5>Henüz listelenecek ürün bulunamadı.</h5>
                            <p class="mb-0 text-muted">Backend API üzerinden ürün eklediğinizde burada otomatik görünecektir.</p>
                        </div>
                    </div>
                }

            </div>
        </div>
        <!-- Shop Product List End -->
    </div>
</div>
<!-- Shop / Product List End -->
